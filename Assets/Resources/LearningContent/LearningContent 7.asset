  MethodologyName: "\u0422\u0435\u0445\u043D\u0438\u043A\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F"
  Description: "\u0421\u0443\u0442\u044C: \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435
    \u2014 \u044D\u0442\u043E \u043D\u0435 \u043C\u043E\u043C\u0435\u043D\u0442,
    \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
    \xAB\u043D\u0443 \u0447\u0442\u043E, \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C?\xBB,
    \u0430 \u0441\u0435\u0440\u0438\u044F \u043F\u0440\u0438\u0451\u043C\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442
    \u043A\u043B\u0438\u0435\u043D\u0442\u0443 \u043F\u0440\u0438\u043D\u044F\u0442\u044C
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0431\u0435\u0437 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F.
    \u041A\u043B\u0438\u0435\u043D\u0442 \u0447\u0430\u0441\u0442\u043E \u0433\u043E\u0442\u043E\u0432
    \u043A\u0443\u043F\u0438\u0442\u044C, \u043D\u043E \u0431\u043E\u0438\u0442\u0441\u044F
    \u043E\u0448\u0438\u0431\u0438\u0442\u044C\u0441\u044F. \u0417\u0430\u0434\u0430\u0447\u0430
    \u2014 \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u0440\u0438\u0441\u043A \u0438
    \u043F\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C
    \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.\r\n\r\n\u0417\u0430\u0447\u0435\u043C
    \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E:\r\n\r\n\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B
    \u043C\u043E\u0433\u0443\u0442 \u0434\u043B\u0438\u0442\u044C\u0441\u044F \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u0435\u0441\u043B\u0438 \u043D\u0435 \u043F\u043E\u043C\u043E\u0447\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u0443
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0448\u0430\u0433.\r\n\r\n\u041A\u043B\u0438\u0435\u043D\u0442
    \u0436\u0434\u0451\u0442, \u0447\u0442\u043E \u0432\u044B \u0432\u043E\u0437\u044C\u043C\u0451\u0442\u0435
    \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0448\u0430\u0433.\r\n\r\n\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u043D\u0435 \u0434\u0430\u0432\u0438\u0442,
    \u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
    \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0435.\r\n\r\n\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
    \u0442\u0435\u0445\u043D\u0438\u043A\u0438:\r\n\r\n1. \u041F\u0440\u044F\u043C\u043E\u0435
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435\r\n\u0421\u0430\u043C\u044B\u0439
    \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u0440\u0438\u0451\u043C \u2014
    \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0448\u0430\u0433, \u0435\u0441\u043B\u0438
    \u043A\u043B\u0438\u0435\u043D\u0442 \u0443\u0436\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D
    \u043F\u043E \u0441\u0443\u0442\u0438.\r\n\r\n\xAB\u0422\u043E\u0433\u0434\u0430
    \u0433\u043E\u0442\u043E\u0432\u0438\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
    \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C \u0432
    \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A?\xBB\r\n\r\n2.
    \u0410\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u043E\u0435
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435\r\n\u0412\u044B
    \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0435
    \xAB\u0431\u0443\u0434\u0435\u0442\u0435 \u0431\u0440\u0430\u0442\u044C?\xBB,
    \u0430 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442\u0435 \u0432\u044B\u0431\u043E\u0440
    \u0438\u0437 \u0434\u0432\u0443\u0445 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432
    \u2014 \u043E\u0431\u0430 \u0432\u0435\u0434\u0443\u0442 \u043A \u0441\u0434\u0435\u043B\u043A\u0435.\r\n\r\n\xAB\u0412\u0430\u043C
    \u0443\u0434\u043E\u0431\u043D\u0435\u0435 \u043D\u0430\u0447\u0430\u0442\u044C
    \u0441 \u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043A\u043B\u0430\u0434\u0430
    \u0438\u043B\u0438 \u0441\u0440\u0430\u0437\u0443 \u0441 \u0434\u0432\u0443\u0445?\xBB\r\n\r\n3.
    \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u043D\u0430 \u043F\u0440\u043E\u0431\u0443
    (\u043F\u0438\u043B\u043E\u0442)\r\n\u0421\u043D\u0438\u0436\u0430\u0435\u0442
    \u0440\u0438\u0441\u043A \u0434\u043B\u044F \u043A\u043B\u0438\u0435\u043D\u0442\u0430:
    \u043E\u043D \u043D\u0435 \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442 \u0441\u0440\u0430\u0437\u0443,
    \u0430 \u0442\u0435\u0441\u0442\u0438\u0440\u0443\u0435\u0442.\r\n\r\n\xAB\u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u043C \u043F\u0438\u043B\u043E\u0442
    \u043D\u0430 \u043C\u0435\u0441\u044F\u0446. \u0415\u0441\u043B\u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u0443\u0441\u0442\u0440\u043E\u0438\u0442 \u2014 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u0435\u043C.
    \u0415\u0441\u043B\u0438 \u043D\u0435\u0442 \u2014 \u0432\u044B \u043D\u0438\u0447\u0435\u0433\u043E
    \u043D\u0435 \u0442\u0435\u0440\u044F\u0435\u0442\u0435\xBB.\r\n\r\n4. \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435
    \u0441 \u0443\u0441\u0442\u0443\u043F\u043A\u043E\u0439\r\n\u0412\u044B \u0434\u0430\u0451\u0442\u0435
    \u0447\u0442\u043E-\u0442\u043E \u0432\u0437\u0430\u043C\u0435\u043D \u043D\u0430
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0437\u0434\u0435\u0441\u044C \u0438
    \u0441\u0435\u0439\u0447\u0430\u0441.\r\n\r\n\xAB\u0415\u0441\u043B\u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u2014 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u043C
    \u0446\u0435\u043D\u0443 \u043D\u0430 \u0433\u043E\u0434. \u0415\u0441\u043B\u0438
    \u043F\u043E\u0437\u0436\u0435 \u2014 \u0446\u0435\u043D\u0430 \u043C\u043E\u0436\u0435\u0442
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C\u0441\u044F\xBB.\r\n\r\n5. \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435
    \u043F\u043E \u0448\u0430\u0433\u0430\u043C\r\n\u0415\u0441\u043B\u0438 \u0441\u0434\u0435\u043B\u043A\u0430
    \u043A\u0440\u0443\u043F\u043D\u0430\u044F, \u0432\u044B \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0435
    \u043D\u0435 \u0432\u0441\u044E \u0441\u0434\u0435\u043B\u043A\u0443, \u0430
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
    \u0448\u0430\u0433.\r\n\r\n\xAB\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0434\u043B\u044F
    \u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043E\u0433\u043B\u0430\u0441\u0443\u0435\u043C
    \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435.
    \u042D\u0442\u043E \u043D\u0438 \u043A \u0447\u0435\u043C\u0443 \u043D\u0435
    \u043E\u0431\u044F\u0437\u044B\u0432\u0430\u0435\u0442, \u043D\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442
    \u043F\u043E\u043D\u044F\u0442\u044C \u043E\u0431\u044A\u0451\u043C \u0440\u0430\u0431\u043E\u0442\xBB.\r\n\r\n6.
    \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u0441 \u0434\u0435\u0434\u043B\u0430\u0439\u043D\u043E\u043C\r\n\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435
    \u043F\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043C\u044F\u0433\u043A\u043E
    \u043F\u043E\u0434\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u0435\u0442 \u043A
    \u0440\u0435\u0448\u0435\u043D\u0438\u044E \u2014 \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
    \u0435\u0441\u043B\u0438 \u0434\u0435\u0434\u043B\u0430\u0439\u043D \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0439,
    \u0430 \u043D\u0435 \u0432\u044B\u0434\u0443\u043C\u0430\u043D\u043D\u044B\u0439.\r\n\r\n\xAB\u0423
    \u043D\u0430\u0441 \u0432\u0440\u0435\u043C\u044F \u0434\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u044B.
    \u0412 \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C
    \u2014 \u043B\u0438\u0431\u043E \u0441 \u0432\u0430\u043C\u0438, \u043B\u0438\u0431\u043E
    \u0441 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u044B\u043C
    \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u043E\u043C\xBB."
  Examples: "\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446: \u0422\u043E\u0433\u0434\u0430
    \u0442\u0430\u043A: 1 000 \u0440\u0443\u0431\u043B\u0435\u0439, \u043E\u0431\u044A\u0451\u043C
    15 000 \u0435\u0434\u0438\u043D\u0438\u0446, \u0444\u0438\u043A\u0441\u0430\u0446\u0438\u044F
    \u043D\u0430 \u0433\u043E\u0434. \u041F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F? (\u043F\u0440\u044F\u043C\u043E\u0435
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435)\r\n\r\n\u041A\u043B\u0438\u0435\u043D\u0442:
    \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C.\r\n\r\n\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446:
    \u041A\u043E\u043D\u0435\u0447\u043D\u043E. \u0410 \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E
    \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0435
    \u2014 \u0446\u0435\u043D\u0430, \u043E\u0431\u044A\u0451\u043C \u0438\u043B\u0438
    \u0441\u0440\u043E\u043A\u0438? (\u0440\u0430\u0431\u043E\u0442\u0430 \u0441
    \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C)\r\n\r\n\u041A\u043B\u0438\u0435\u043D\u0442:
    \u0426\u0435\u043D\u0430. \u0412\u0434\u0440\u0443\u0433 \u0447\u0435\u0440\u0435\u0437
    \u043F\u043E\u043B\u0433\u043E\u0434\u0430 \u043D\u0430\u0439\u0434\u0451\u043C
    \u0434\u0435\u0448\u0435\u0432\u043B\u0435.\r\n\r\n\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446:
    \u041F\u043E\u043D\u0438\u043C\u0430\u044E. \u0422\u043E\u0433\u0434\u0430 \u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u0442\u0430\u043A: \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u043C \u0446\u0435\u043D\u0443
    \u043D\u0430 \u0433\u043E\u0434, \u043D\u043E \u0435\u0441\u043B\u0438 \u0432\u044B
    \u043D\u0430\u0439\u0434\u0451\u0442\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0441 \u0442\u0435\u043C \u0436\u0435
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E\u043C \u2014 \u043C\u044B \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0438\u043C
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F. \u042D\u0442\u043E \u043F\u0440\u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C
    \u0432 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0435. \u0422\u0430\u043A \u0432\u044B
    \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u044B. \u041F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C?
    (\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u0441 \u0443\u0441\u0442\u0443\u043F\u043A\u043E\u0439)\r\n\r\n\u041A\u043B\u0438\u0435\u043D\u0442:
    \u0425\u043E\u0440\u043E\u0448\u043E, \u0434\u0430\u0432\u0430\u0439\u0442\u0435."
