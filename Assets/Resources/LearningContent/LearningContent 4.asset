  MethodologyName: "\u041E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0438"
  Description: "\u0421\u0443\u0442\u044C: \u0420\u0435\u0448\u0435\u043D\u0438\u0435
    \u0434\u043E\u043B\u0436\u043D\u043E \u043E\u043F\u0438\u0440\u0430\u0442\u044C\u0441\u044F
    \u043D\u0435 \u043D\u0430 \u0432\u043E\u043B\u044E, \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0438\u043B\u0438 \u0443\u0441\u0442\u0443\u043F\u043A\u0438, \u0430 \u043D\u0430
    \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044B\u0435, \u0438\u0437\u043C\u0435\u0440\u0438\u043C\u044B\u0435
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u0440\u0438\u0437\u043D\u0430\u044E\u0442 \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B.
    \u042D\u0442\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u0441\u043F\u043E\u0440 \xAB\u044F \u0445\u043E\u0447\u0443\xBB \u043F\u0440\u043E\u0442\u0438\u0432
    \xAB\u044F \u0445\u043E\u0447\u0443\xBB \u0432 \u043F\u043E\u0438\u0441\u043A
    \xAB\u0447\u0442\u043E \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E
    \u043F\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u043C
    \u043C\u0435\u0440\u043A\u0430\u043C\xBB.\r\n\r\n\u0417\u0430\u0447\u0435\u043C
    \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E:\r\n\r\n\u041D\u0438\u043A\u0442\u043E
    \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442 \u0441\u0435\u0431\u044F
    \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u0432\u0448\u0438\u043C \u2014 \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043E \u043D\u0430 \u0444\u0430\u043A\u0442\u0430\u0445,
    \u0430 \u043D\u0435 \u043D\u0430 \u0442\u043E\u043C, \u043A\u0442\u043E \u043A\u043E\u0433\u043E
    \u043F\u0435\u0440\u0435\u0441\u043F\u043E\u0440\u0438\u043B.\r\n\r\n\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443
    \u0441\u043B\u043E\u0436\u043D\u043E \u0432\u043E\u0437\u0440\u0430\u0436\u0430\u0442\u044C
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439
    \u0446\u0435\u043D\u044B, \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u043D\u043E\u0439
    \u043E\u0446\u0435\u043D\u043A\u0438 \u0438\u043B\u0438 \u0437\u0430\u043A\u043E\u043D\u0430.\r\n\r\n\u0412\u044B
    \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u0435\u0442\u0435\u0441\u044C \u043E
    \u0446\u0438\u0444\u0440\u0430\u0445, \u0430 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E
    \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0439,
    \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u0438\u0445 \u0441\u0447\u0438\u0442\u0430\u0442\u044C.\r\n\r\n\u041A\u0430\u043A\u0438\u0435
    \u0431\u044B\u0432\u0430\u044E\u0442 \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0438:\r\n\r\n\u0420\u044B\u043D\u043E\u0447\u043D\u044B\u0435
    \u0446\u0435\u043D\u044B \u0438 \u0438\u043D\u0434\u0435\u043A\u0441\u044B\r\n\r\n\u0417\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u043E\u0432\r\n\r\n\u041E\u0442\u0440\u0430\u0441\u043B\u0435\u0432\u044B\u0435
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u044B \u0438 \u043D\u043E\u0440\u043C\u044B\r\n\r\n\u041F\u0440\u0435\u0446\u0435\u0434\u0435\u043D\u0442\u044B
    \u0438 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438\r\n\r\n\u0417\u0430\u043A\u043E\u043D\u044B
    \u0438 \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u0430\u043A\u0442\u044B\r\n\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
    \u043F\u0438\u043B\u043E\u0442\u043D\u044B\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432
    \u0438 \u0437\u0430\u043C\u0435\u0440\u043E\u0432\n\n\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
    \u043C\u0430\u0440\u043A\u0435\u0440\u044B:\r\n\r\n\xAB\u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442\u044C \u043E \u0446\u0438\u0444\u0440\u0430\u0445,
    \u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430
    \u0444\u0430\u043A\u0442\u044B\xBB\r\n\r\n\xAB\u041A\u0430\u043A\u0430\u044F
    \u0441\u0440\u0435\u0434\u043D\u044F\u044F \u0446\u0435\u043D\u0430 \u043F\u043E
    \u0440\u044B\u043D\u043A\u0443?\xBB\r\n\r\n\xAB\u0427\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u044F\u0442
    \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u044B / \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u044B
    / \u043E\u0442\u0440\u0430\u0441\u043B\u0435\u0432\u044B\u0435 \u043D\u043E\u0440\u043C\u044B?\xBB\r\n\r\n\xAB\u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u0437\u0430\u043C\u0435\u0440\u0438\u043C \u0438 \u0441\u0440\u0430\u0432\u043D\u0438\u043C\xBB\r\n\r\n\xAB\u0415\u0441\u043B\u0438
    \u0434\u0430\u043D\u043D\u044B\u0435 \u043F\u043E\u043A\u0430\u0436\u0443\u0442
    \u0438\u043D\u043E\u0435 \u2014 \u043C\u044B \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0438\u043C\xBB\r\n\r\n\u0427\u0435\u043C
    \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442 BATNA:\r\nBATNA
    \u2014 \u044D\u0442\u043E \u0432\u0430\u0448 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439
    \u043F\u043B\u0430\u043D, \u0435\u0441\u043B\u0438 \u043D\u0435 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435\u0441\u044C.
    \u041E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0438
    \u2014 \u044D\u0442\u043E \u043E\u0441\u043D\u043E\u0432\u0430 \u0434\u043B\u044F
    \u0441\u0430\u043C\u043E\u0433\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044F,
    \u043F\u043E\u043A\u0430 \u0432\u044B \u0435\u0449\u0451 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C.
    BATNA \u0434\u0430\u0432\u0438\u0442 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043E\u0439,
    \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0438
    \u0443\u0431\u0435\u0436\u0434\u0430\u044E\u0442 \u0444\u0430\u043A\u0442\u0430\u043C\u0438.\r\n\r\n\u0427\u0435\u043C
    \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442 MESO:\r\nMESO
    \u2014 \u0432\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442\u0435
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0432\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0445
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u043D\u0430 \u0432\u044B\u0431\u043E\u0440. \u041E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u2014 \u0432\u044B \u0432\u043C\u0435\u0441\u0442\u0435
    \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043C\u0435\u0440\u043A\u0443,
    \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0435
    \u043E\u0434\u0438\u043D \u0432\u0430\u0440\u0438\u0430\u043D\u0442. MESO \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u044B, \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0438 \u2014 \u043E\u0431\u043E\u0441\u043D\u043E\u0432\u044B\u0432\u0430\u044E\u0442
    \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C."
  Examples: "\u041A\u043B\u0438\u0435\u043D\u0442: \u0412\u0430\u0448\u0430 \u0446\u0435\u043D\u0430
    1 200 \u2014 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0432\u044B\u0441\u043E\u043A\u0430\u044F.
    \u0414\u0430\u0432\u0430\u0439\u0442\u0435 1 000.\r\n\r\n\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446:
    \u041F\u043E\u043D\u0438\u043C\u0430\u044E. \u041D\u043E \u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442\u044C \u043E \u0446\u0438\u0444\u0440\u0430\u0445,
    \u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C \u043D\u0430 \u0440\u044B\u043D\u043E\u0447\u043D\u044B\u0435
    \u0434\u0430\u043D\u043D\u044B\u0435. \u0421\u0440\u0435\u0434\u043D\u044F\u044F
    \u0446\u0435\u043D\u0430 \u043D\u0430 \u0430\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0435
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B \u043F\u043E \u043E\u0442\u0440\u0430\u0441\u043B\u0438
    \u2014 1 150 \u0440\u0443\u0431\u043B\u0435\u0439. \u0412\u043E\u0442 \u043E\u0442\u0447\u0451\u0442
    \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043A\u0432\u0430\u0440\u0442\u0430\u043B.
    \u041C\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u043C 1 200,
    \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C
    \u0438\u043C\u043F\u043E\u0440\u0442\u043D\u044B\u0435 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u044E\u0449\u0438\u0435.
    \u0415\u0441\u043B\u0438 \u0432\u044B \u043D\u0430\u0439\u0434\u0451\u0442\u0435
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0434\u0435\u0448\u0435\u0432\u043B\u0435
    \u0441 \u0442\u0435\u043C \u0436\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E\u043C
    \u2014 \u043C\u044B \u0433\u043E\u0442\u043E\u0432\u044B \u043E\u0431\u0441\u0443\u0434\u0438\u0442\u044C.
    \u0418\u043B\u0438 \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u0434\u0435\u043B\u0430\u0435\u043C
    \u0442\u0430\u043A: \u0432\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043F\u0440\u043E\u0431\u043D\u0443\u044E
    \u043F\u0430\u0440\u0442\u0438\u044E, \u043C\u044B \u0437\u0430\u043C\u0435\u0440\u044F\u0435\u043C
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F
    \u0437\u0430 \u043C\u0435\u0441\u044F\u0446 \u0438 \u0441\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u0435\u043C
    \u0441 \u0432\u0430\u0448\u0438\u043C\u0438 \u0442\u0435\u043A\u0443\u0449\u0438\u043C\u0438
    \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u043C\u0438. \u0415\u0441\u043B\u0438
    \u0440\u0430\u0437\u043D\u0438\u0446\u0430 \u043D\u0435 \u0432 \u043D\u0430\u0448\u0443
    \u043F\u043E\u043B\u044C\u0437\u0443 \u2014 \u043F\u0435\u0440\u0435\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u043C
    \u0446\u0435\u043D\u0443. \u041A\u0430\u043A \u0432\u0430\u043C \u0442\u0430\u043A\u043E\u0439
    \u043F\u043E\u0434\u0445\u043E\u0434?\r\n\r\n\u041A\u043B\u0438\u0435\u043D\u0442:
    \u0425\u043E\u0440\u043E\u0448\u043E, \u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u043D\u0430\u0447\u043D\u0451\u043C \u0441 \u043F\u0440\u043E\u0431\u043D\u043E\u0439
    \u043F\u0430\u0440\u0442\u0438\u0438."
