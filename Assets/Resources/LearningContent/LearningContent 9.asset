  MethodologyName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u044D\u043C\u043F\u0430\u0442\u0438\u044F"
  Description: "\u0421\u0443\u0442\u044C: \u042D\u0442\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
    \u043F\u043E\u043D\u044F\u0442\u044C \u0438 \u0432\u0435\u0440\u0431\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u044D\u043C\u043E\u0446\u0438\u0438 \u0438 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u0435\u0442
    \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u0430\u044F
    \u0441\u0442\u043E\u0440\u043E\u043D\u0430, \u2014 \u043D\u0435 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u044F\u0441\u044C
    \u0441 \u043D\u0438\u043C\u0438, \u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F,
    \u0447\u0442\u043E \u0432\u044B \u0438\u0445 \u0432\u0438\u0434\u0438\u0442\u0435
    \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435. \u042D\u0442\u043E
    \u043D\u0435 \u0441\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435 \u0438
    \u043D\u0435 \u0443\u0441\u0442\u0443\u043F\u043A\u0430, \u0430 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
    \u0434\u043B\u044F \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F \u0437\u0430\u0449\u0438\u0442\u044B
    \u0438 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0434\u043E\u0432\u0435\u0440\u0438\u044F.\r\n\r\n\u0410\u0432\u0442\u043E\u0440
    \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u0438: \u041A\u0440\u0438\u0441
    \u0412\u043E\u0441\u0441 (Chris Voss), \u0431\u044B\u0432\u0448\u0438\u0439 \u0432\u0435\u0434\u0443\u0449\u0438\u0439
    \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A \u0424\u0411\u0420
    \u043F\u043E \u0437\u0430\u0445\u0432\u0430\u0442\u0443 \u0437\u0430\u043B\u043E\u0436\u043D\u0438\u043A\u043E\u0432,
    \u0430\u0432\u0442\u043E\u0440 \u043A\u043D\u0438\u0433\u0438 \xABNever Split
    the Difference\xBB. \u041E\u043D \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u043F\u043E\u0434\u0445\u043E\u0434 \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    24-\u043B\u0435\u0442\u043D\u0435\u0433\u043E \u043E\u043F\u044B\u0442\u0430
    \u0432 \u0424\u0411\u0420, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0431\u043E\u043B\u0435\u0435
    150 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
    \u0434\u0435\u043B \u043E \u043F\u043E\u0445\u0438\u0449\u0435\u043D\u0438\u044F\u0445
    .\r\n\r\n\u0417\u0430\u0447\u0435\u043C \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E:\r\n\r\n\u041A\u043E\u0433\u0434\u0430
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442,
    \u0447\u0442\u043E \u0435\u0433\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0442,
    \u043E\u043D \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442 \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C\u0441\u044F
    \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0442\u044C
    .\r\n\r\n\u042D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u043B\u043E\u0433\u0438\u043A\u0430
    \u0438 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u044B: \xAB\u0424\u0430\u043A\u0442\u044B
    \u0443\u0431\u0435\u0436\u0434\u0430\u044E\u0442 \u0440\u0430\u0437\u0443\u043C.
    \u041E\u0449\u0443\u0449\u0435\u043D\u0438\u0435, \u0447\u0442\u043E \u0442\u0435\u0431\u044F
    \u043F\u043E\u043D\u044F\u043B\u0438, \u0434\u0432\u0438\u0433\u0430\u0435\u0442
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435\xBB .\r\n\r\n\u0421\u043D\u0438\u0436\u0430\u0435\u0442
    \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0432 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043C\u043E\u043C\u0435\u043D\u0442 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430.\n\n\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B\r\n1. \u041C\u0430\u0440\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    (Labeling)\r\n\u0412\u044B \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
    \u044D\u043C\u043E\u0446\u0438\u044E \u0438\u043B\u0438 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
    \u0443 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A\u0430, \u043D\u0430\u0447\u0438\u043D\u0430\u044F
    \u0441 \u0444\u0440\u0430\u0437 \xAB\u041F\u043E\u0445\u043E\u0436\u0435, \u0447\u0442\u043E\u2026\xBB,
    \xAB\u0417\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E\u2026\xBB,
    \xAB\u0422\u0430\u043A\u043E\u0435 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435,
    \u0447\u0442\u043E\u2026\xBB. \u0412\u0430\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \xAB\u0442\u044B/\u0432\u044B\xBB, \u0430 \u043D\u0435 \xAB\u044F\xBB, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \xAB\u044F\xBB \u0446\u0435\u043D\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043D\u0430 \u0432\u0430\u0441,
    \u0430 \u043D\u0435 \u043D\u0430 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A\u0435
    .\r\n\r\n\xAB\u041F\u043E\u0445\u043E\u0436\u0435, \u043D\u0430 \u0432\u0430\u0441
    \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0435
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u043D\u0443\u0442\u0440\u0438
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438, \u0447\u0442\u043E\u0431\u044B
    \u0432\u044B \u043D\u0435 \u0441\u043D\u0438\u0436\u0430\u043B\u0438 \u0446\u0435\u043D\u0443\xBB
    .\r\n\r\n\u041D\u0435\u0439\u0440\u043E\u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043E\u0431\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435: \u043A\u043E\u0433\u0434\u0430
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u0430\u043C \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0438\u043B\u0438 \u0441\u043B\u044B\u0448\u0438\u0442 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
    \u0441\u0432\u043E\u0435\u0439 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E\u0439
    \u044D\u043C\u043E\u0446\u0438\u0438, \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0432 \u043C\u0438\u043D\u0434\u0430\u043B\u0435\u0432\u0438\u0434\u043D\u043E\u043C
    \u0442\u0435\u043B\u0435 (\u0446\u0435\u043D\u0442\u0440 \u0441\u0442\u0440\u0430\u0445\u0430)
    \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F .\r\n\r\n2. \u041E\u0442\u0437\u0435\u0440\u043A\u0430\u043B\u0438\u0432\u0430\u043D\u0438\u0435
    (Mirroring)\r\n\u0412\u044B \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442\u0435
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 1\u20133 \u0441\u043B\u043E\u0432\u0430
    \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A\u0430 \u2014 \u0432
    \u0432\u0438\u0434\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u0430 \u0438\u043B\u0438
    \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F. \u042D\u0442\u043E
    \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0435\u0433\u043E
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0438 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
    .\r\n\r\n\u0421\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A: \xAB\u042D\u0442\u043E
    \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u0441\u043C\u0435\u0445\u043E\u0442\u0432\u043E\u0440\u043D\u043E\xBB.\r\n\u0412\u044B:
    \xAB\u0421\u043C\u0435\u0445\u043E\u0442\u0432\u043E\u0440\u043D\u043E?\xBB\r\n\r\n\u0427\u0435\u043B\u043E\u0432\u0435\u043A
    \u043D\u0430\u0447\u043D\u0451\u0442 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C,
    \u043F\u043E\u0447\u0435\u043C\u0443 \u0435\u043C\u0443 \u0442\u0430\u043A \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
    \u0438 \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
    \u0434\u0430\u043D\u043D\u044B\u0445 \u043E \u0435\u0433\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445.\r\n\r\n3. \u041C\u043E\u043B\u0447\u0430\u043D\u0438\u0435
    \u043F\u043E\u0441\u043B\u0435 \u043C\u0430\u0440\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F\r\n\u041F\u043E\u0441\u043B\u0435
    \u0442\u043E\u0433\u043E \u043A\u0430\u043A \u0432\u044B \u043D\u0430\u0437\u0432\u0430\u043B\u0438
    \u044D\u043C\u043E\u0446\u0438\u044E, \u0437\u0430\u043C\u043E\u043B\u0447\u0438\u0442\u0435.
    \u0414\u0430\u0439\u0442\u0435 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A\u0443
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0443\u0441\u043B\u044B\u0448\u0430\u043D\u043D\u043E\u0435
    \u0438 \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C. \u0418\u043C\u0435\u043D\u043D\u043E
    \u0432 \u044D\u0442\u043E\u0439 \u043F\u0430\u0443\u0437\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0441\u0434\u0432\u0438\u0433"
  Examples: "\u041A\u043B\u0438\u0435\u043D\u0442: \xAB\u0412\u0430\u0448\u0430 \u0446\u0435\u043D\u0430
    1 200 \u2014 \u044D\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u043E. \u0423
    \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432 980\xBB.\r\n\r\n\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446:
    \xAB\u041F\u043E\u0445\u043E\u0436\u0435, \u0432\u044B \u043F\u043E\u0434 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
    \u2014 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0443, \u0447\u0442\u043E
    \u0432\u044B \u0432\u044B\u0436\u0430\u043B\u0438 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C
    \u0438\u0437 \u0431\u044E\u0434\u0436\u0435\u0442\u0430\xBB.\r\n\r\n(\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435)\r\n\r\n\u041A\u043B\u0438\u0435\u043D\u0442:
    \xAB\u0414\u0430, \u0435\u0441\u043B\u0438 \u044F \u0441\u043E\u0433\u043B\u0430\u0448\u0443\u0441\u044C
    \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435,
    \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C
    \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u044F \u043D\u0435 \u043F\u0440\u043E\u0432\u0451\u043B
    \u0440\u0430\u0431\u043E\u0442\u0443\xBB.\r\n\r\n\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446:
    \xAB\u0422\u043E\u0433\u0434\u0430 \u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u0442\u0430\u043A: \u044F \u0434\u0430\u043C \u0432\u0430\u043C \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0435
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438 \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F
    \u0441 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043E\u0439
    \u2014 \u044D\u0442\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u0442\u044C
    \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u043E\u0431\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044E.
    \u041F\u043E\u0434\u043E\u0439\u0434\u0451\u0442?\xBB\r\n\r\n\u041A\u043B\u0438\u0435\u043D\u0442:
    \xAB\u0414\u0430, \u044D\u0442\u043E \u0440\u0435\u0448\u0438\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\xBB."
