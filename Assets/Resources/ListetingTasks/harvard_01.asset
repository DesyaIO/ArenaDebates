  AudioClip: {fileID: 8300000, guid: 5c5095ed7ceacba47bd70ed11dc4a4b1, type: 3}
  CorrectMethodology: "\u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043A\u0438\u0439
    \u043C\u0435\u0442\u043E\u0434"
  CorrectExplanation: "1. \u041E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u043B\u044E\u0434\u0435\u0439 \u043E\u0442 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B\r\n\u0421\u0442\u043E\u0440\u043E\u043D\u044B
    \u043D\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442 \u043D\u0430
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438 \u0438 \u043D\u0435 \u043E\u0431\u0432\u0438\u043D\u044F\u044E\u0442
    \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430. \u0412\u043C\u0435\u0441\u0442\u043E
    \xAB\u0432\u044B \u043D\u0435 \u0445\u043E\u0442\u0438\u0442\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C\xBB
    \u0438\u043B\u0438 \xAB\u0432\u044B \u0437\u0430\u0432\u044B\u0448\u0430\u0435\u0442\u0435
    \u0441\u0440\u043E\u043A\u0438\xBB \u0437\u0432\u0443\u0447\u0438\u0442: \xAB\u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u043D\u0435 \u0431\u0443\u0434\u0435\u043C \u0441\u043F\u043E\u0440\u0438\u0442\u044C
    \u043E \u0446\u0438\u0444\u0440\u0430\u0445\xBB\r\n\u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
    \u2014 \u0441\u0440\u043E\u043A\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438,
    \u0430 \u043D\u0435 \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442. \u042D\u0442\u043E
    \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0437\u043D\u0430\u043A
    \u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043A\u043E\u0433\u043E \u043C\u0435\u0442\u043E\u0434\u0430:
    \u043C\u044F\u0433\u043A\u043E \u0441 \u043B\u044E\u0434\u044C\u043C\u0438, \u0436\u0451\u0441\u0442\u043A\u043E
    \u0441 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439.\n\n2. \u0424\u043E\u043A\u0443\u0441
    \u043D\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445, \u0430 \u043D\u0435
    \u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044F\u0445\r\n\u041F\u043E\u0437\u0438\u0446\u0438\u0438
    \u0441\u0442\u043E\u0440\u043E\u043D:\r\n\u0417\u0430\u043A\u0443\u043F\u0449\u0438\u043A:
    \xAB\u043D\u0443\u0436\u043D\u043E 30 \u0434\u043D\u0435\u0439\xBB\r\n\u041F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A:
    \xAB\u043D\u0443\u0436\u043D\u043E 45 \u0434\u043D\u0435\u0439\xBB\r\n\u041D\u043E
    \u0437\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044F\u043C\u0438 \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B:\r\n\xAB\u0414\u043B\u044F \u043D\u0430\u0441
    \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u043D \u0437\u0430\u043F\u0443\u0441\u043A
    \u043A 15-\u043C\u0443 \u0447\u0438\u0441\u043B\u0443\xBB\r\n\xAB\u0414\u043B\u044F
    \u043D\u0430\u0441 \u0432\u0430\u0436\u043D\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
    \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0438 \u043D\u0435 \u0437\u0430\u0433\u043D\u0430\u0442\u044C
    \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \u0432 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0438\xBB\r\n\u0418
    \u0434\u0430\u043B\u0435\u0435 \u043F\u0440\u044F\u043C\u043E\u0435 \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435:\r\n\xAB\u0412\u0430\u0448
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u2014 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0438 \u043D\u0435 \u0432\u044B\u0433\u043E\u0440\u0435\u0442\u044C.
    \u041D\u0430\u0448 \u2014 \u0443\u043B\u043E\u0436\u0438\u0442\u044C\u0441\u044F
    \u0432 \u0434\u0435\u0434\u043B\u0430\u0439\u043D. \u042D\u0442\u043E \u043D\u0435
    \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0442 \u0434\u0440\u0443\u0433
    \u0434\u0440\u0443\u0433\u0443\xBB\r\n\u042D\u0442\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439
    \u043C\u0430\u0440\u043A\u0435\u0440: \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u044E\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u043E \u0446\u0438\u0444\u0440\u0430\u0445 \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E \u0442\u043E\u043C, \u043F\u043E\u0447\u0435\u043C\u0443
    \u044D\u0442\u0438 \u0446\u0438\u0444\u0440\u044B \u0432\u0430\u0436\u043D\u044B.\n\n3.
    \u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u0434\u043B\u044F \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u0439
    \u0432\u044B\u0433\u043E\u0434\u044B\r\n\u041A\u043E\u0433\u0434\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B
    \u0432\u044B\u044F\u0441\u043D\u0435\u043D\u044B, \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u043D\u0435 \u0434\u0435\u043B\u0438\u0442 \u043F\u0438\u0440\u043E\u0433, \u0430
    \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442 \u0435\u0433\u043E:\r\n\r\n\xAB\u0427\u0442\u043E
    \u0435\u0441\u043B\u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u043C \u0437\u0430\u043A\u0430\u0437
    \u043D\u0430 \u0434\u0432\u0435 \u043F\u0430\u0440\u0442\u0438\u0438: \u043F\u0435\u0440\u0432\u0443\u044E
    \u2014 30% \u2014 \u0432\u044B \u043E\u0442\u0433\u0440\u0443\u0436\u0430\u0435\u0442\u0435
    \u0437\u0430 30 \u0434\u043D\u0435\u0439, \u0432\u0442\u043E\u0440\u0443\u044E
    \u2014 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u2014 \u0437\u0430
    45?\xBB\r\n\r\n\u042D\u0442\u043E \u043D\u0435 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441
    \xAB30 \u043F\u0440\u043E\u0442\u0438\u0432 45\xBB, \u0430 \u043D\u043E\u0432\u0430\u044F
    \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F: \u0437\u0430\u043A\u0443\u043F\u0449\u0438\u043A
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043F\u0435\u0440\u0432\u0443\u044E
    \u043F\u0430\u0440\u0442\u0438\u044E \u0432\u043E\u0432\u0440\u0435\u043C\u044F,
    \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A \u043D\u0435 \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442
    \u0432\u0435\u0441\u044C \u0437\u0430\u043A\u0430\u0437. \u041E\u0431\u0430 \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u044E\u0442.\n\n4.
    \u041E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0438\r\n\u0420\u0435\u0448\u0435\u043D\u0438\u0435
    \u043E\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043D\u0435 \u043D\u0430
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438 \u043D\u0435 \u043D\u0430
    \xAB\u0443\u0441\u0442\u0443\u043F\u0438 \u043C\u043D\u0435\xBB, \u0430 \u043D\u0430
    \u0438\u0437\u043C\u0435\u0440\u0438\u043C\u044B\u0435 \u0444\u0430\u043A\u0442\u044B:\r\n\xAB\u0421\u043A\u043E\u043B\u044C\u043A\u043E
    \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0441\u043C\u0435\u043D\u0430?\xBB \u2014 \xAB150 \u0442\u044B\u0441\u044F\u0447\xBB\r\n\xAB\u0421\u043A\u043E\u043B\u044C\u043A\u043E
    \u043D\u0430\u043C \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u043D\u044C \u043F\u0440\u043E\u0441\u0442\u043E\u044F?\xBB
    \u2014 \xAB200 \u0442\u044B\u0441\u044F\u0447\xBB\r\n\u0418 \u0432\u044B\u0432\u043E\u0434:\r\n\xAB\u0415\u0441\u043B\u0438
    \u043C\u044B \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u0443\u0435\u043C
    \u0432\u0430\u043C 150 \u0442\u044B\u0441\u044F\u0447 \u0437\u0430 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435,
    \u043C\u044B \u043E\u0431\u0430 \u0432 \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u0435\xBB\r\n\u042D\u0442\u043E
    \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0439:
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0441\u043C\u0435\u043D\u044B
    \u0438 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u043E\u044F.
    \u041D\u0435 \xAB\u044F \u0442\u0430\u043A \u0445\u043E\u0447\u0443\xBB, \u0430
    \xAB\u0446\u0438\u0444\u0440\u044B \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442,
    \u0447\u0442\u043E \u0442\u0430\u043A \u0432\u044B\u0433\u043E\u0434\u043D\u043E
    \u043E\u0431\u043E\u0438\u043C\xBB.\n"
  AvailableMethodologies:
  - "\u0413\u0430\u0440\u0432\u0430\u0440\u0434\u0441\u043A\u0438\u0439 \u043C\u0435\u0442\u043E\u0434"
