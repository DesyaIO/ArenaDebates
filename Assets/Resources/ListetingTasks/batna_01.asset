  AudioClip: {fileID: 8300000, guid: 901dac39d55d3e948a0f1c640103bd4e, type: 3}
  CorrectMethodology: BATNA
  CorrectExplanation: "1. \u041A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0430\u044F
    \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0430, \u0430
    \u043D\u0435 \u0430\u0431\u0441\u0442\u0440\u0430\u043A\u0442\u043D\u0430\u044F
    \u0443\u0433\u0440\u043E\u0437\u0430\r\nBATNA \u2014 \u044D\u0442\u043E \u043D\u0435
    \xAB\u043C\u044B \u043C\u043E\u0436\u0435\u043C \u0443\u0439\u0442\u0438\xBB,
    \u0430 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0441 \u0446\u0438\u0444\u0440\u0430\u043C\u0438 \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438.
    \u0412 \u0434\u0438\u0430\u043B\u043E\u0433\u0435 \u044D\u0442\u043E \u0437\u0432\u0443\u0447\u0438\u0442
    \u043F\u0440\u044F\u043C\u043E:\r\n\xAB\u0423 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043E\u0442
    \u0434\u0440\u0443\u0433\u0438\u0445: 980, 1 000 \u0438 \u0432\u0430\u0448\u0435\xBB\r\n\xAB\u041D\u0430\u0448\u0430
    \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0430 \u2014
    980 \u0441 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u043E\u0439 \u0437\u0430
    3 \u0434\u043D\u044F\xBB\r\n\u042D\u0442\u043E \u043D\u0435 \u0431\u043B\u0435\u0444
    \u0438 \u043D\u0435 \u0440\u0430\u0441\u043F\u043B\u044B\u0432\u0447\u0430\u0442\u043E\u0435
    \xAB\u043C\u044B \u043F\u043E\u0434\u0443\u043C\u0430\u0435\u043C\xBB. \u0415\u0441\u0442\u044C
    \u0446\u0435\u043D\u0430, \u0435\u0441\u0442\u044C \u0441\u0440\u043E\u043A \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438,
    \u0435\u0441\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C
    \u0443\u0439\u0442\u0438. \u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A
    \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0430\u044F
    BATNA.\r\n\r\n2. \u0413\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C
    \u0443\u0439\u0442\u0438\r\n\u0421\u0438\u043B\u0430 BATNA \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0435 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u043E\u043D\u0430
    \u0435\u0441\u0442\u044C, \u0430 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E
    \u0441\u0442\u043E\u0440\u043E\u043D\u0430 \u0433\u043E\u0442\u043E\u0432\u0430
    \u0435\u0451 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C.
    \u0410\u043B\u0435\u043A\u0441\u0435\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
    \u043E\u0431 \u044D\u0442\u043E\u043C \u043F\u0440\u044F\u043C\u043E:\r\n\r\xAB\u041C\u044B
    \u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u043D\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u0441 \u0432\u0430\u043C\u0438 \u2014 \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C
    \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0430, \u0438
    \u043C\u044B \u0433\u043E\u0442\u043E\u0432\u044B \u0435\u0451 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\xBB\r\n\r\xAB\u0415\u0441\u043B\u0438
    \u043D\u0435\u0442 \u2014 \u0443\u0445\u043E\u0434\u0438\u043C \u043A \u0442\u0435\u043C,
    \u043A\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B 980\xBB\r\n\r\xAB\u0415\u0441\u043B\u0438
    \u043D\u0435 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C\u0441\u044F
    \u2014 \u0443\u0445\u043E\u0434\u0438\u043C\xBB\r\n\r\u042D\u0442\u043E \u043D\u0435
    \u0443\u0433\u0440\u043E\u0437\u0430 \u0432 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u043C
    \u0441\u043C\u044B\u0441\u043B\u0435, \u0430 \u043A\u043E\u043D\u0441\u0442\u0430\u0442\u0430\u0446\u0438\u044F
    \u0444\u0430\u043A\u0442\u0430. \u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A
    BATNA \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0440\u044B\u0447\u0430\u0433.\r\n\r\n3. \u0422\u043E\u0447\u043A\u0430
    \u043E\u0442\u043A\u0430\u0437\u0430\r\n\u0423 \u0410\u043B\u0435\u043A\u0441\u0435\u044F
    \u0435\u0441\u0442\u044C \u0447\u0451\u0442\u043A\u0430\u044F \u0433\u0440\u0430\u043D\u0438\u0446\u0430,
    \u043D\u0438\u0436\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u043D
    \u043D\u0435 \u043F\u043E\u0439\u0434\u0451\u0442, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0435\u0433\u043E \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0430
    \u043B\u0443\u0447\u0448\u0435:\r\n\r\xAB\u0415\u0441\u043B\u0438 \u0433\u043E\u0442\u043E\u0432\u044B
    \u043D\u0430 1 000 \u2014 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u043C.
    \u0415\u0441\u043B\u0438 \u043D\u0435\u0442 \u2014 \u0443\u0445\u043E\u0434\u0438\u043C
    \u043A \u0442\u0435\u043C, \u043A\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
    980\xBB\r\n\r\u041E\u043D \u043D\u0435 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 1 200, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E BATNA
    \u2014 980. \u041E\u043D \u0442\u043E\u0440\u0433\u0443\u0435\u0442\u0441\u044F
    \u0434\u043E 1 000 \u2014 \u0432\u044B\u0448\u0435 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u044B,
    \u043D\u043E \u0441 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438. \u042D\u0442\u043E \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0442\u043E\u0447\u043A\u0430 \u043E\u0442\u043A\u0430\u0437\u0430, \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u043D\u0430 BATNA.\r\n\r\n4. \u041F\u0435\u0440\u0435\u0432\u043E\u0434 \u0432
    \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435\r\n\u041A\u043E\u0433\u0434\u0430
    \u0446\u0435\u043D\u0430 \u0443\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043F\u0440\u0435\u0434\u0435\u043B, \u0410\u043B\u0435\u043A\u0441\u0435\u0439
    \u043D\u0435 \u0434\u0430\u0432\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0446\u0435\u043D\u043E\u0439 \u2014 \u043E\u043D \u043C\u0435\u043D\u044F\u0435\u0442
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443 \u0441\u0434\u0435\u043B\u043A\u0438:\r\n\r\xAB15
    000 \u0435\u0434\u0438\u043D\u0438\u0446 \u0432 \u043A\u0432\u0430\u0440\u0442\u0430\u043B
    \u0432\u043C\u0435\u0441\u0442\u043E 10 000, \u0446\u0435\u043D\u0430 1 000,
    \u0444\u0438\u043A\u0441\u0430\u0446\u0438\u044F \u043D\u0430 \u0433\u043E\u0434.
    \u0418\u043B\u0438 \u0446\u0435\u043D\u0430 1 200, \u043D\u043E \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u044F
    36 \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u0438 \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0430
    \u0437\u0430 \u0432\u0430\u0448 \u0441\u0447\u0451\u0442\xBB\r\n\r\u042D\u0442\u043E
    \u0442\u0438\u043F\u0438\u0447\u043D\u044B\u0439 \u043F\u0440\u0438\u0451\u043C
    \u043F\u0440\u0438 \u0441\u0438\u043B\u044C\u043D\u043E\u0439 BATNA: \u0435\u0441\u043B\u0438
    \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0443
    \u043D\u0435 \u0441\u0445\u043E\u0434\u0438\u043C\u0441\u044F, \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u043C
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0432 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u2014 \u043E\u0431\u044A\u0451\u043C,
    \u0441\u0440\u043E\u043A\u0438, \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u044E,
    \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0443.\r\n\r\n5. \u0414\u0435\u0434\u043B\u0430\u0439\u043D
    \u043A\u0430\u043A \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0435\r\nBATNA
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0435,
    \u043A\u043E\u0433\u0434\u0430 \u0435\u0441\u0442\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0435
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435:\r\n\r\xAB\u0412\u0440\u0435\u043C\u044F
    \u0434\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u044B. \u0412 \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A
    \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C \u2014 \u043B\u0438\u0431\u043E
    \u0441 \u0432\u0430\u043C\u0438, \u043B\u0438\u0431\u043E \u0441 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u044B\u043C
    \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u043E\u043C\xBB\r\n\r\u042D\u0442\u043E
    \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0418\u0433\u043E\u0440\u044F
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u044C
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0430
    \u0410\u043B\u0435\u043A\u0441\u0435\u044F \u043D\u0438\u043A\u0443\u0434\u0430
    \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F."
