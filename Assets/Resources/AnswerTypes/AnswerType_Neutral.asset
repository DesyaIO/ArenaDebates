  TypeName: "\u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439/\u0423\u0442\u043E\u0447\u043D\u044F\u044E\u0449\u0438\u0439"
  Description: "\u041E\u0442\u0432\u0435\u0442 \u043D\u0435 \u043D\u0435\u0441\u0451\u0442
    \u044F\u0432\u043D\u043E\u0439 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438: \u0437\u0430\u043F\u0440\u043E\u0441
    \u0444\u0430\u043A\u0442\u043E\u0432, \u0443\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u0435,
    \u043F\u0435\u0440\u0435\u0444\u0440\u0430\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435,
    \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435
    \u0431\u0435\u0437 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432."
